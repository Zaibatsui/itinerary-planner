# Copy to .env and fill in what you need. Everything is optional; most of it can also be set later in the app's Settings.
PORT=8095
# Public web address of the planner (used for Google sign-in redirects), e.g. https://trips.example.com
BASE_URL=
# Password for the first "admin" account. Leave empty to create the first account in the browser on first visit.
APP_PASSWORD=
# Google OAuth client (Calendar + Gmail). Can also be entered in Settings → Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CARTO basemaps key (free: https://carto.com/basemaps/apikey/). Can also be entered in Settings → Map.
CARTO_KEY=
# Contact (email or website) sent to the Transitous public transport API, as their usage policy asks.
CONTACT=
